NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Use a dedicated Bravo database. Transactions require a replica set (Atlas supports this).
MONGODB_URI=
MONGODB_DB=bravo_k9
# Test keys first. Live checkout also requires STRIPE_LIVE_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=false
# Explicitly opt into test Checkout on a production URL only during supervised QA.
STRIPE_TEST_CHECKOUT_ENABLED=false
# Private lesson files for self-hosted Node deployments (never client/public).
PRIVATE_MEDIA_DIR=./private/media

# Required for founder-only operations and owner bootstrap; no fallback identity.
# Set to the existing founder MongoDB user ObjectId before deploying.
OWNER_USER_ID=

# Optional carrier-network TURN relay. Set ONLY ONE provider after approval.
# Long-lived values stay server-side; never use a VITE_ prefix.
# Cloudflare Realtime TURN:
# BRAVO_TURN_KEY_ID=
# BRAVO_TURN_API_TOKEN=
# Or your authenticated coturn service (production requires valid TLS on 443):
# BRAVO_TURN_URLS=["turn:your-relay.example:3478?transport=udp","turn:your-relay.example:3478?transport=tcp","turns:your-relay.example:443?transport=tcp"]
# BRAVO_TURN_SHARED_SECRET=
