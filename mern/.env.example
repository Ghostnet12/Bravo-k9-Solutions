NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Use a dedicated Bravo database. Transactions require a replica set (Atlas supports this).
MONGODB_URI=
MONGODB_DB=bravo_k9
# Test keys first. Live checkout also requires STRIPE_LIVE_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=false
# Explicitly opt into test Checkout on a production URL only during supervised QA.
STRIPE_TEST_CHECKOUT_ENABLED=false
# Private lesson files for self-hosted Node deployments (never client/public).
PRIVATE_MEDIA_DIR=./private/media

# Required for founder-only operations and owner bootstrap; no fallback identity.
# Set to the existing founder MongoDB user ObjectId before deploying.
OWNER_USER_ID=

# Optional cellular/restricted-network media relay. Production secrets only;
# do not prefix these with VITE_ or commit real values. Without a configured
# provider the existing direct-only path remains; cellular is NOT guaranteed.
BRAVO_TURN_PROVIDER=disabled
# Cloudflare Realtime TURN key ID + server API token (not a global API key):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Alternative: owner-operated coturn server, TLS 443 recommended in production.
BRAVO_TURN_URLS=
BRAVO_TURN_SHARED_SECRET=
# all = direct + TURN fallback; relay = force relay for acceptance testing.
BRAVO_LIVE_ICE_POLICY=all

