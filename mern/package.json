{
  "name": "bravo-k9-mern",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --config vite.config.js\"",
    "build": "vite build --config vite.config.js && node scripts/page-metadata.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:database": "node --test tests/database.integration.js",
    "staff": "node --env-file-if-exists=.env scripts/staff.js",
    "lint": "eslint server shared api client/src --max-warnings=0"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.7",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.0.0",
    "parse5": "7.3.0",
    "pdfkit": "^0.17.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.13.0",
    "stripe": "^22.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "mongodb-memory-server": "^11.0.0",
    "supertest": "^7.2.2",
    "vite": "8.0.16"
  }
}
