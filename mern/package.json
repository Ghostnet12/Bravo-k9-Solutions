{
  "name": "bravo-k9-mern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --config vite.config.js\"",
    "build": "vite build --config vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:database": "node --test tests/database.integration.js",
    "staff": "node --env-file-if-exists=.env scripts/staff.js"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.13.0",
    "express": "^5.1.0",
    "mongoose": "^9.0.0",
    "stripe": "^20.0.0",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "luxon": "^3.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "mongodb-memory-server": "^11.0.0"
  }
}
