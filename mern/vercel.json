{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "client/dist/**",
      "maxDuration": 60
    },
    "api/home.js": {
      "includeFiles": "client/dist/**",
      "maxDuration": 60
    },
    "api/public-page.js": {
      "includeFiles": "client/dist/**",
      "maxDuration": 60
    },
    "api/maintenance.js": {
      "maxDuration": 60
    },
    "api/live/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/reset-password",
      "destination": "/api/reset-password"
    },
    {
      "source": "/api/reset-password/:token",
      "destination": "/api/reset-password"
    },
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/dog-training",
      "destination": "/api/public-page?path=/dog-training"
    },
    {
      "source": "/behavior-assessment",
      "destination": "/api/public-page?path=/behavior-assessment"
    },
    {
      "source": "/dog-walking",
      "destination": "/api/public-page?path=/dog-walking"
    },
    {
      "source": "/learn",
      "destination": "/api/public-page?path=/learn"
    },
    {
      "source": "/contact",
      "destination": "/api/public-page?path=/contact"
    },
    {
      "source": "/accessibility",
      "destination": "/api/public-page?path=/accessibility"
    },
    {
      "source": "/media-rights",
      "destination": "/api/public-page?path=/media-rights"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/schedule",
      "destination": "/schedule.html"
    },
    {
      "source": "/workshops",
      "destination": "/api/public-page?path=/workshops"
    },
    {
      "source": "/live",
      "destination": "/api/public-page?path=/live"
    },
    {
      "source": "/live/studio",
      "destination": "/live/studio.html"
    },
    {
      "source": "/hunting-dog-training",
      "destination": "/api/public-page?path=/hunting-dog-training"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-src https://www.facebook.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ashley-profile.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/live-sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/live/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bravo-shell.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dog-training.html",
      "destination": "/dog-training",
      "permanent": true
    },
    {
      "source": "/behavior-assessment.html",
      "destination": "/behavior-assessment",
      "permanent": true
    },
    {
      "source": "/dog-walking.html",
      "destination": "/dog-walking",
      "permanent": true
    },
    {
      "source": "/learn.html",
      "destination": "/learn",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/accessibility.html",
      "destination": "/accessibility",
      "permanent": true
    },
    {
      "source": "/media-rights.html",
      "destination": "/media-rights",
      "permanent": true
    },
    {
      "source": "/portal.html",
      "destination": "/portal",
      "permanent": true
    },
    {
      "source": "/account.html",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/community.html",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/reset-password.html",
      "destination": "/reset-password",
      "permanent": true
    },
    {
      "source": "/schedule.html",
      "destination": "/schedule",
      "permanent": true
    },
    {
      "source": "/workshops.html",
      "destination": "/workshops",
      "permanent": true
    },
    {
      "source": "/live.html",
      "destination": "/live",
      "permanent": true
    },
    {
      "source": "/live/studio.html",
      "destination": "/live/studio",
      "permanent": true
    },
    {
      "source": "/hunting-dog-training.html",
      "destination": "/hunting-dog-training",
      "permanent": true
    }
  ]
}
