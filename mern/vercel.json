{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "crons": [
    {
      "path": "/api/cron/memberships",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/dog-sitting",
      "destination": "/portal",
      "permanent": true
    },
    {
      "source": "/dog-training.html",
      "destination": "/dog-training",
      "permanent": true
    },
    {
      "source": "/behavior-assessment.html",
      "destination": "/behavior-assessment",
      "permanent": true
    },
    {
      "source": "/dog-walking.html",
      "destination": "/dog-walking",
      "permanent": true
    },
    {
      "source": "/portal.html",
      "destination": "/portal",
      "permanent": true
    },
    {
      "source": "/learn.html",
      "destination": "/learn",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/account.html",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/schedule.html",
      "destination": "/schedule",
      "permanent": true
    },
    {
      "source": "/reset-password.html",
      "destination": "/reset-password",
      "permanent": true
    },
    {
      "source": "/community.html",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/accessibility.html",
      "destination": "/accessibility",
      "permanent": true
    },
    {
      "source": "/media-rights.html",
      "destination": "/media-rights",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bravo-shell.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{client/dist/*.html,client/public/fonts/montserrat-*.ttf}"
    },
    "api/homepage.js": {
      "maxDuration": 60,
      "includeFiles": "client/dist/bravo-shell.html"
    },
    "api/public-page.js": {
      "maxDuration": 60,
      "includeFiles": "client/dist/*.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/homepage"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/dog-training",
      "destination": "/api/public-page?path=/dog-training"
    },
    {
      "source": "/behavior-assessment",
      "destination": "/api/public-page?path=/behavior-assessment"
    },
    {
      "source": "/dog-walking",
      "destination": "/api/public-page?path=/dog-walking"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/learn",
      "destination": "/learn.html"
    },
    {
      "source": "/contact",
      "destination": "/api/public-page?path=/contact"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/schedule",
      "destination": "/schedule.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/accessibility",
      "destination": "/api/public-page?path=/accessibility"
    },
    {
      "source": "/media-rights",
      "destination": "/api/public-page?path=/media-rights"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-src https://www.facebook.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(account|admin|community|schedule|reset-password|portal)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "trailingSlash": false
}
